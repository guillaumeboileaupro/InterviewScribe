{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InterviewScribe",
  "version": "0.1.2",
  "identifier": "com.guillaumeboileau.interviewscribe",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm models:verify && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InterviewScribe",
        "width": 1180,
        "height": 780,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Transcription locale d'entretiens",
    "longDescription": "Transcription locale en temps reel ou a posteriori avec separation des intervenants.",
    "resources": {
      "resources/models/": "models/"
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
